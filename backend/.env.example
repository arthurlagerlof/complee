DATABASE_URL=postgresql+psycopg://shipdesign_app:CHANGE_ME@localhost:5432/tsdb
APP_ENV=development
DEBUG=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://complee.netlify.app,http://45.32.211.82
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_MODEL_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DEVICE=cpu

AI_REQUEST_TIMEOUT_SECONDS=60
AI_ALLOWED_HOSTS=localhost,127.0.0.1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OLLAMA_MODELS=
OLLAMA_MODEL=
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
# Optional: answers when GEMINI_MODEL is overloaded (503, timeout) or out of quota (429); recorded per answer
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Fast model chain: Claude Opus 5.5 fast first, then GPT-6.1 Sol ultrafast, GPT-6 Astra fast, then Gemini.
# A step without a key is skipped. Next model on error, refusal, invalid answer or after the step timeout.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# AI_MODEL_CHAIN=anthropic:claude-opus-5-5:speed=fast,openai:gpt-6.1-sol:service_tier=ultrafast,openai:gpt-6-astra:service_tier=fast
AI_CHAIN_STEP_TIMEOUT_SECONDS=45
# Hard output cap per request (cost ceiling): 8000 tokens on Opus fast is at most about 0.32 USD
AI_CHAIN_MAX_TOKENS=8000

VULTR_API_KEY=
MODEL_DIR=
PORT=800