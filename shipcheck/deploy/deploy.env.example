# Copy to deploy/deploy.env (gitignored) and fill in. Never commit deploy.env.
SERVER_HOST=
SERVER_USER=root
# Folder on the server
REMOTE_DIR=/opt/shipcheck
# Optional: a domain whose DNS A record points at the server -> automatic HTTPS. Empty: plain HTTP on port 80.
DOMAIN=
# Optional: sites allowed to call the API from a browser, comma-separated (default: localhost only)
ALLOWED_ORIGINS=
# Optional: MODEL_SOURCE=vultr streams the 3D model tiles from Vultr Object Storage (the bucket holds the exported
# model/ folder) instead of uploading the local model/ folder (~1 GB). The keys go to the server only (deploy/server.env).
MODEL_SOURCE=
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_REGION=
# Optional: SSH key file (default: your normal SSH key)
SSH_KEY=
