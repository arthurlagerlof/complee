# Copy to deploy/deploy.env (gitignored) and fill in. Never commit deploy.env.
SERVER_HOST=
SERVER_USER=root
# Folder on the server
REMOTE_DIR=/opt/shipcheck
# Optional: a domain whose DNS A record points at the server -> automatic HTTPS. Empty: plain HTTP on port 80.
DOMAIN=
# Optional: sites allowed to call the API from a browser, comma-separated (default: localhost only)
ALLOWED_ORIGINS=
# Optional: SSH key file (default: your normal SSH key)
SSH_KEY=
