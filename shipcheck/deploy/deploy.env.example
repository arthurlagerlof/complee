# Copy to deploy/deploy.env (gitignored) and fill in. Never commit deploy.env.
SERVER_HOST=
SERVER_USER=root
# Folder on the server
REMOTE_DIR=/opt/shipcheck
# Set the DNS A record to the server for automatic HTTPS through Caddy; empty means HTTP only.
DOMAIN=
# Exact website origins allowed by browser CORS, comma-separated (no paths or wildcard).
# For a Netlify site, include https://<site>.netlify.app and any custom site origin.
ALLOWED_ORIGINS=
# For Cloudflare Quick Tunnel mode, bind Caddy only to loopback and trust Cloudflare's client-IP header.
# Leave CADDY_BIND_ADDRESS empty and TRUST_CLOUDFLARE_TUNNEL=false for direct Caddy deployments.
CADDY_BIND_ADDRESS=
TRUST_CLOUDFLARE_TUNNEL=false
# Required for the database-backed ShipCheck catalog. This address must be reachable from the app container.
SHIPCHECK_DATA_API_URL=
# Optional override for regulation-text requests; defaults to SHIPCHECK_DATA_API_URL.
REGULATION_API_URL=
# Use vultr to stream the existing private model bucket without uploading/duplicating its tiles.
# The keys go to the server only (deploy/server.env); they are never included in browser assets or requests.
MODEL_SOURCE=
VULTR_S3_ENDPOINT=
VULTR_S3_BUCKET=
VULTR_S3_ACCESS_KEY=
VULTR_S3_SECRET_KEY=
VULTR_S3_REGION=
# Optional: SSH key file (default: your normal SSH key)
SSH_KEY=
