# Dependencies
node_modules/

# Secrets: never commit keys (APS keys live in 3D_Since_AI/.env)
.env
.env.*
**/.env
**/.env.*

# Evidence source corpus (local, large)
integrations/sinceai/data/*.jsonl

# APS model folder: the source model and the large extracted JSON stay local
# Staged outside the repository; import into the database via the backend catalog importer.
3D_Since_AI/*.nwd
3D_Since_AI/model-properties.json
3D_Since_AI/model-tree.json

# Generated output
results.json
reports/
*.log

# Source documents (rule PDFs, GA drawings): licensed, keep local
source/

# Editor, OS and tool files
.claude/
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Local viewer model chunks (exported from the RCRV model; too big for Git; deployed with deploy.sh / deploy.ps1)
model/
# Export tooling dependencies and intermediate files
tools/export/node_modules/
tools/export/work/
# Server deploy settings (host, user)
deploy.env

# Disk cache of model tiles fetched from object storage (MODEL_SOURCE=vultr)
.cache/
