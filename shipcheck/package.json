{
  "name": "shipcheck",
  "version": "0.2.0",
  "private": true,
  "description": "Deterministic class and regulatory compliance checker for ship designs (Since AI Hackathon 2026, Meyer Turku challenge)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test --test-concurrency=1",
    "check": "node scripts/check.mjs",
    "prepare-model": "node scripts/prepare-model.mjs",
    "report": "node scripts/check.mjs --report"
  },
  "dependencies": {
    "three": "0.160.0",
    "three-mesh-bvh": "^0.7.6"
  }
}
