# Copy to .env (never commit .env). Everything here is OPTIONAL: without keys the tool runs fully
# offline and the AI buttons are hidden. The AI never decides pass/fail.

# EU-hosted option (Mistral AI, Paris)
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# Any OpenAI-compatible server, e.g. a local model on the engineer's laptop
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=mistral-small

# Pick one if several keys are set: mistral | anthropic | openai-compatible
# AI_PROVIDER=mistral

# PORT=8080
